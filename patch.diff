+function extractValidBoxes(rawBoxes, rawPoints) {
+  const boxes = [];
+  const boxPoints = [];
+  for (let i = 0; i < rawBoxes.length; i++) {
+    const box = normalizeBox(rawBoxes[i]);
+    if (box) {
+      boxes.push(box);
+      boxPoints.push(normalizePoints(rawPoints[i]));
+    }
+  }
+  return { boxes, boxPoints };
+}
